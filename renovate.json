{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchPackageNames": ["yt-dlp"],
      "rangeStrategy": "bump",
      "postUpgradeTasks": {
        "commands": ["uv version --bump minor --no-sync"],
        "fileFilters": ["pyproject.toml", "uv.lock"],
        "executionMode": "branch"
      }
    }
  ]
}
